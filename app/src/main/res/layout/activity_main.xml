<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#ffffff"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_menu"
                android:background="#f3f4f6"
                android:contentDescription="Menú"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚕 App de Conductores"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1f2937" />

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desconectado"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="#f3f4f6"
                android:textColor="#6b7280"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/toggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conectar"
                android:backgroundTint="#10b981"
                android:textColor="#ffffff"
                android:paddingHorizontal="20dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#f0fdf4"
                android:layout_marginEnd="8dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/todayRidesTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Viajes Hoy"
                    android:textSize="12sp"
                    android:textColor="#065f46" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#eff6ff"
                android:layout_marginStart="8dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/todayEarningsTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs 0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#2563eb" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ganancia"
                    android:textSize="12sp"
                    android:textColor="#1d4ed8" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rideRequestLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#fef3c7"
        android:layout_margin="16dp"
        android:layout_marginBottom="8dp"
        android:elevation="2dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo Pedido de Viaje!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#92400e"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtPassengerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pasajero: -"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#78350f"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/pickupTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recogida: -"
            android:textSize="16sp"
            android:textColor="#78350f"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/destinationTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destino: -"
            android:textSize="16sp"
            android:textColor="#78350f"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/fareTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarifa: -"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#92400e"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tiempo restante: 40s"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#dc2626"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressCountdown"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="40"
            android:progress="40"
            android:progressTint="#10b981"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/acceptRideButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aceptar"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#10b981"
                android:textColor="#ffffff" />

            <Button
                android:id="@+id/rejectRideButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rechazar"
                android:backgroundTint="#ef4444"
                android:textColor="#ffffff" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/activeRideLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#dbeafe"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:elevation="2dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viaje en Curso"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1e40af"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/activeRidePassengerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pasajero: -"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1e3a8a"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/activeRidePickup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recogida: -"
            android:textSize="16sp"
            android:textColor="#1e3a8a"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/activeRideDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destino: -"
            android:textSize="16sp"
            android:textColor="#1e3a8a"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/activeRideFare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarifa: -"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1e40af"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/callPassengerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Llamar"
                android:drawableStart="@android:drawable/sym_action_call"
                android:drawablePadding="8dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#10b981"
                android:textColor="#ffffff"
                android:visibility="gone" />

            <Button
                android:id="@+id/whatsappButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WhatsApp"
                android:drawableStart="@android:drawable/sym_action_chat"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#25d366"
                android:textColor="#ffffff"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavigate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#3b82f6"
                android:src="@android:drawable/ic_menu_directions"
                android:tint="#ffffff"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/arrivedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ya estoy aquí"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#f59e0b"
                android:textColor="#ffffff"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startRideButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Iniciar Viaje"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#3b82f6"
                    android:textColor="#ffffff"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/completeRideButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Finalizar Viaje"
                    android:backgroundTint="#10b981"
                    android:textColor="#ffffff"
                    android:enabled="false"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/cancelRideButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancelar Viaje"
                    android:backgroundTint="#ef4444"
                    android:textColor="#ffffff" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        tools:context=".MainActivity" />

</LinearLayout>
