<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#10b981"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 Saldo y Comisiones"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#ffffff" />

        <TextView
            android:id="@+id/tvTotalBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bs 0"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo total"
            android:textSize="14sp"
            android:textColor="#d1fae5" />

    </LinearLayout>

    <!-- RESUMEN DEL DÍA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#ffffff"
        android:layout_margin="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Resumen de Hoy"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1f2937"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDayTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs 0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#10b981" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total"
                    android:textSize="12sp"
                    android:textColor="#6b7280" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDayCommission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs 0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#ef4444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comisión (10%)"
                    android:textSize="12sp"
                    android:textColor="#6b7280" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDayNet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs 0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#3b82f6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Neto"
                    android:textSize="12sp"
                    android:textColor="#6b7280" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- LISTA DE CARRERAS DEL DÍA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#ffffff"
        android:layout_marginHorizontal="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Detalle de Carreras"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1f2937"
            android:layout_marginBottom="12dp" />

        <ListView
            android:id="@+id/listViewRides"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:divider="#e5e7eb"
            android:dividerHeight="1dp" />

    </LinearLayout>

</LinearLayout>
